# Copy this file to .env only if you want to override the defaults.
# `docker compose up --build` works without a .env file.

POSTGRES_USER=events
POSTGRES_PASSWORD=events
POSTGRES_DB=events

FRONTEND_PORT=8080
LOG_LEVEL=info

RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Browser origin for CORS when the API is called cross-origin.
# Same-origin through nginx does not need a specific origin.
CORS_ORIGIN=*
